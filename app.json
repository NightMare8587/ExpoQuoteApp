{
  "expo": {
    "name": "YourQuoteApp",
    "slug": "YourQuoteApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher-web.png",
    "scheme": "quoteapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.consumers.QuoteApp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher-web.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.consumers.QuoteApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ic_launcher-web.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b552d785-b4a3-4e9a-ab59-dbc070b6f97f"
      }
    }
  }
}
